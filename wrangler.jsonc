{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "e-library-frontend",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "e-library-frontend"
    }
  ],
  // API_URL is set in the Cloudflare dashboard so the backend URL stays out of the repo;
  // without this, every deploy deletes dashboard variables that aren't listed here
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
